# JustSing configuration — copy to .env (or export) as needed.
# All defaults work with ZERO cost: no API keys, no GPU required.

# Accompaniment generator backend:
#   procedural         = built-in local synthesizer (zero cost, works everywhere) [default, varied per song] v0.10 phrase-following
#   musicgen-melody    = Mureka-level! Meta MusicGen Melody follows YOUR melody via chroma (zero-cost, self-hosted, no API key, needs torch+audiocraft, ~4GB) — BEST QUALITY, like Mureka Remix
#   musicgen-small     = text-only 300M, fast, ~1GB, no melody following but high quality
#   musicgen-medium    = text-only 1.5B, better quality
#   musicgen-large     = text-only 3.3B, best quality
#   openrouter         = OpenRouter prompt-based adaptive (key/BPM/range + hash, $0.04-$0.08/song, $1 free)
#   openrouter-dynamic = TRUE audio-to-music! OpenRouter LISTENS to your voice (2-step: Gemini analyzes audio, then Lyria composes) — like Sora, dynamic per voice — $0.09/song
#   elevenlabs         = ElevenLabs Music API (needs ELEVENLABS_API_KEY) — 10k free credits
#   lyria              = Google Lyria 3.5 via Gemini API (needs GEMINI_API_KEY) — $0.08/song
#   stable-audio-open  = self-hosted Stability open weights (needs a GPU)
GENERATOR=procedural

# MusicGen Melody (Mureka-level, zero-cost, no API key)
# Install: pip install torch torchaudio --index-url https://download.pytorch.org/whl/cpu
#          pip install audiocraft
# Then set GENERATOR=musicgen-melody

# OpenRouter FREE $1 = 12 songs
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/lyria-3-pro-preview
OPENROUTER_SITE_URL=https://github.com/17sushil/JustSing
OPENROUTER_APP_NAME=JustSing

# ElevenLabs FREE 10k/month
ELEVENLABS_API_KEY=

# Google Gemini direct
GEMINI_API_KEY=

# Vocal separation
SEPARATOR=none

# Whisper: off = faster, no hang, recommended for MVP. auto = needs faster-whisper install
WHISPER=off
WHISPER_MODEL=base

STORAGE_DIR=storage
TARGET_RMS=0.18
MP3_BITRATE=320k
WORKERS=2

# Beat tracking: 0 = stable energy fallback (default, no segfault), 1 = librosa (more accurate but may segfault)
USE_LIBROSA=0
