# SingSmith configuration — copy to .env (or export) as needed.
# All defaults work with ZERO cost: no API keys, no GPU required.

# Accompaniment generator backend:
#   procedural       = built-in local synthesizer (zero cost, works everywhere) [default]
#   openrouter       = OpenRouter proxy for Lyria (YES, OpenRouter key works! $0.04-$0.08/song, $1 free credit)
#   elevenlabs       = ElevenLabs Music API (needs ELEVENLABS_API_KEY)  — 10k free credits
#   lyria            = Google Lyria 3.5 via Gemini API (needs GEMINI_API_KEY) — $0.08/song
#   stable-audio-open= self-hosted Stability open weights (needs a GPU)
#   musicgen         = self-hosted Meta MusicGen (needs a GPU; CC-BY-NC license)
GENERATOR=procedural

# --- FREE API KEYS (optional, for higher quality) ---

# OpenRouter — YES, it works for JustSing! Get $1 free credit on signup.
# Sign up at https://openrouter.ai/ → https://openrouter.ai/settings/keys → Create Key
# Models: google/lyria-3-pro-preview ($0.08/song, best) or google/lyria-3-clip-preview ($0.04/clip, cheaper)
# Also has free models like minimax/music-2.6-free (check https://openrouter.ai/models?o=free)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/lyria-3-pro-preview
# Optional, for OpenRouter dashboard attribution (helps with rate limits)
OPENROUTER_SITE_URL=https://github.com/17sushil/JustSing
OPENROUTER_APP_NAME=JustSing

# ElevenLabs — 10,000 free credits/month
# Get key at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Google Gemini (for direct Lyria access, without OpenRouter)
# Get key at https://ai.google.dev/ → Get API key
GEMINI_API_KEY=

# Vocal separation backend (only needed if users upload videos WITH music in them):
#   none     = pass-through, upload assumed to be a dry vocal [default]
#   demucs   = self-hosted Demucs (pip install demucs; needs a GPU for speed)
SEPARATOR=none

# Lyrics + language detection (any language) via local Whisper:
#   auto = use it if faster-whisper is installed [default]
#   off  = skip (saves ~150 MB download + CPU time)
WHISPER=auto
WHISPER_MODEL=base

# Where uploads, jobs and renders are stored (relative to project root)
STORAGE_DIR=storage

# Mastering target (~ -14 dBFS RMS ≈ streaming loudness) and MP3 bitrate
TARGET_RMS=0.18
MP3_BITRATE=320k

# Number of songs rendered in parallel
WORKERS=2
