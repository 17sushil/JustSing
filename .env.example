# SingSmith configuration — copy to .env (or export) as needed.
# All defaults work with ZERO cost: no API keys, no GPU required.

# Accompaniment generator backend:
#   procedural       = built-in local synthesizer (zero cost, works everywhere) [default]
#   elevenlabs       = ElevenLabs Music API (needs ELEVENLABS_API_KEY)  — blueprint §5
#   lyria            = Google Lyria 3.5 via Gemini API (needs GEMINI_API_KEY)
#   stable-audio-open= self-hosted Stability open weights (needs a GPU)
#   musicgen         = self-hosted Meta MusicGen (needs a GPU; CC-BY-NC license)
GENERATOR=procedural

# Vocal separation backend (only needed if users upload videos WITH music in them):
#   none     = pass-through, upload assumed to be a dry vocal [default]
#   demucs   = self-hosted Demucs (pip install demucs; needs a GPU for speed)
SEPARATOR=none

# Lyrics + language detection (any language) via local Whisper:
#   auto = use it if faster-whisper is installed [default]
#   off  = skip (saves ~150 MB download + CPU time)
WHISPER=auto
WHISPER_MODEL=base

# Where uploads, jobs and renders are stored (relative to project root)
STORAGE_DIR=storage

# Mastering target (~ -14 dBFS RMS ≈ streaming loudness) and MP3 bitrate
TARGET_RMS=0.18
MP3_BITRATE=320k

# Number of songs rendered in parallel
WORKERS=2
